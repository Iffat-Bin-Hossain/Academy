# ==============================================================================
# Production Environment Variables Reference (Neon DB + Render + Vercel)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NEON DB (PostgreSQL) - Set these on Render Web Service
# ------------------------------------------------------------------------------
# Neon DB Dashboard -> Connection Details -> Choose "Parameters only" or "JDBC":
# JDBC URL format:
#   jdbc:postgresql://<neon-endpoint-id>.us-east-2.aws.neon.tech/neondb?sslmode=require
#
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your_neon_db_password_here

# Hibernate DDL (use 'update' so tables are automatically created on Neon DB)
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 2. BACKEND (Render Web Service)
# ------------------------------------------------------------------------------
# Active Spring profile
SPRING_PROFILES_ACTIVE=docker

# Application Secret Key for JWT Tokens (Generate a secure 64+ char string)
JWT_SECRET=generate_a_very_secure_random_base64_or_hex_string_here_32_bytes_min

# Hikari Connection Pool Settings (Optimized for Neon DB Serverless Postgres)
HIKARI_MAX_POOL_SIZE=10
HIKARI_MIN_IDLE=2
HIKARI_MAX_LIFETIME=240000
HIKARI_KEEPALIVE_TIME=30000

# Persistent / Local file uploads
UPLOAD_DIR=/app/data/uploads

# Optional Email Configuration (Gmail SMTP or SendGrid/Resend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=noreply@academy.com

# ------------------------------------------------------------------------------
# 3. FRONTEND (Vercel Project Settings -> Environment Variables)
# ------------------------------------------------------------------------------
# Your deployed Render backend URL (NO trailing slash)
REACT_APP_BACKEND_URL=https://academy-backend.onrender.com
